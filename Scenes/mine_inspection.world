<?xml version="1.0"?>
<sdf version="1.8">
  <world name="default">

    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <!-- ==================== EXTERIOR SCENE ==================== -->
    <scene>
      <ambient>0.45 0.42 0.38 1</ambient>
      <background>0.55 0.65 0.78 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Directional sunlight — arid midday angle -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.95 0.90 0.80 1</diffuse>
      <specular>0.3 0.28 0.22 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.1 -0.85</direction>
    </light>

    <!-- ==================== EXTERIOR GROUND ==================== -->
    <!-- Arid rocky terrain surrounding the mine — large flat plane
         coloured like dry sandstone/laterite (reddish-tan) -->
    <model name="exterior_ground">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry>
            <plane><normal>0 0 1</normal><size>300 300</size></plane>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <plane><normal>0 0 1</normal><size>300 300</size></plane>
          </geometry>
          <material>
            <ambient>0.62 0.52 0.38 1</ambient>
            <diffuse>0.62 0.52 0.38 1</diffuse>
            <specular>0.05 0.04 0.03 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Rocky cliff face around the mine entrance portal
         (south face — rover enters from here) -->
    <model name="cliff_s_left">
      <static>true</static><pose>-12 -27 8 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>16 4 16</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>16 4 16</size></box></geometry>
          <material><ambient>0.50 0.40 0.30 1</ambient>
            <diffuse>0.50 0.40 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="cliff_s_right">
      <static>true</static><pose>12 -27 8 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>16 4 16</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>16 4 16</size></box></geometry>
          <material><ambient>0.50 0.40 0.30 1</ambient>
            <diffuse>0.50 0.40 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="cliff_s_top">
      <static>true</static><pose>0 -27 18 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>8 4 4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8 4 4</size></box></geometry>
          <material><ambient>0.48 0.38 0.28 1</ambient>
            <diffuse>0.48 0.38 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Portal arch lintel -->
    <model name="portal_lintel">
      <static>true</static><pose>0 -25.5 4.5 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>4.6 0.6 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.6 0.6 1.5</size></box></geometry>
          <material><ambient>0.35 0.28 0.22 1</ambient>
            <diffuse>0.35 0.28 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>
